:root {
}

.Score {
    font-size: 100px;
    align-self: flex-start;
    align-content: flex-start;
    align-items: stretch;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    margin-top: 0;
}

.Text {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    font-size: 18px;
    -unity-text-align: upper-center;
    white-space: pre;
}

.Header {
    justify-content: flex-start;
    align-self: center;
    margin-top: 20px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    color: rgb(255, 255, 255);
    font-size: 100px;
}

.h2 {
    align-self: center;
    margin-top: 12px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    font-size: 40px;
}

.h3 {
    -unity-font-style: normal;
    flex-basis: auto;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    align-self: center;
    align-content: flex-start;
    justify-content: flex-start;
    align-items: flex-start;
    -unity-text-align: upper-left;
    font-size: 26px;
}

.Exp-Player-Text {
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    font-size: 22px;
    align-self: center;
    margin-top: 20px;
}

.Button {
    background-color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    color: rgb(0, 0, 0);
    font-size: 18px;
    -unity-font-style: bold;
    width: 270px;
}

.Button-Hover:hover {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    color: rgb(255, 255, 255);
    background-color: rgb(0, 0, 0);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
}

.input {
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(0, 0, 0);
}

.pong-input {
    width: 500px;
    min-width: auto;
    align-self: center;
    padding-top: 0;
    margin-top: 30px;
    min-height: auto;
    justify-content: flex-start;
    max-height: none;
    height: 80px;
    cursor: initial;
}

.pong-input > .unity-text-field__input {
    background-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    color: rgb(255, 255, 255);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    font-size: 20px;
    width: auto;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-bottom: 0;
    cursor: initial;
}

.Start-Button {
    width: auto;
    height: auto;
    align-self: center;
    font-size: 25px;
    padding-top: 35px;
    padding-bottom: 35px;
    padding-left: 110px;
    padding-right: 110px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
}

.Start-Button:hover {
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
}

.Score-Player {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    color: rgb(255, 253, 253);
    font-size: 30px;
    min-width: 350px;
    max-width: 350px;
}

.game-over-button {
    margin-right: 50px;
    margin-left: 50px;
    min-width: 300px;
    max-width: 300px;
    color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
    font-size: 22px;
    background-color: rgb(255, 255, 255);
}

.game-over-button:hover {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    background-color: rgb(0, 0, 0);
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/PressStart2P-Regular.ttf?fileID=12800000&guid=d2853fcdf5d583c4482751da1e67afdc&type=3#PressStart2P-Regular");
}

.Pointer {
    cursor: url("project://database/Assets/UI%20Toolkit/pointer-cursor.png?fileID=2800000&guid=f25d9a2844ae8df4facf7bd29d8c8864&type=3#pointer-cursor");
}
